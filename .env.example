# Supabase Connect dialog: Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Settings > API Keys: publishable key (sb_publishable_...)
# The existing variable name is retained for compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Settings > API Keys: secret key (sb_secret_...), server only.
# A legacy service_role key also works; never expose either in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key